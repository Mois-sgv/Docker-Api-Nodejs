{
  "family": "primer-docker-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::294321867399:role/miEcsTaskExecutionRole",
  "runtimePlatform": {
    "operatingSystemFamily": "WINDOWS_SERVER_2022_CORE",
    "cpuArchitecture": "X86_64"
  },
  "containerDefinitions": [
    {
      "name": "mi-contenedor-ubuntu",
      "image": "ghcr.io/mois-sgv/primer-docker:latest",
      "cpu": 1024,
      "memory": 2048,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/primer-docker",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}
